# --- Required ---
XAI_API_KEY=xai-your-key-here

# grok-4.6 is the current flagship. Cheaper options: grok-4.3, grok-build-0.1
GROK_MODEL=grok-4.6

# Personality / instructions
SYSTEM_PROMPT=You are Grok, built by xAI. Be helpful, direct, and a little witty. Keep answers concise unless the user asks for depth.

# --- Channels (enable at least one) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs. Empty = anyone can talk to the bot (not recommended).
TELEGRAM_ALLOWED_USER_IDS=

DISCORD_BOT_TOKEN=
# Comma-separated Discord channel IDs the bot may reply in. Empty = reply in any channel when @mentioned or DMed.
DISCORD_CHANNEL_IDS=

# Web chat on the VPS (http://YOUR_IP:8080). Set a shared secret so the page is not public.
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_ACCESS_KEY=change-me

# --- Behavior ---
MAX_HISTORY_TURNS=20
MAX_OUTPUT_TOKENS=4096
TEMPERATURE=0.7
XAI_BASE_URL=https://api.x.ai/v1
